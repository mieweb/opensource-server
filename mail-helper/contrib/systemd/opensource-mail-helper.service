[Unit]
Description=MIE opensource-server mail helper (unsubscribe milter)
Documentation=https://github.com/mieweb/opensource-server/issues/67
After=network.target
PartOf=postfix.service

[Service]
Type=simple
User=opensource-mail
# postfix group so the chrooted smtpd can connect to the milter socket.
Group=postfix
# Group= replaces the user's primary group, and system users are not listed
# as members of their own group in /etc/group — without this the process
# never carries the opensource-mail gid and cannot read config.local.json
# (root:opensource-mail 0640, written by the agent).
SupplementaryGroups=opensource-mail
WorkingDirectory=/opt/opensource-server/mail-helper
ExecStart=/usr/bin/node /opt/opensource-server/mail-helper/src/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/spool/postfix/mail-helper

[Install]
WantedBy=multi-user.target
