# Managed by opensource-agent — Postfix virtual_alias_maps (live SQL).
# Per-account forwarding: one row per destination; Postfix joins multiple
# rows with commas. A row mapping the address to itself keeps a local copy.
hosts = <%= db.hosts %>
user = <%= db.user %>
<%_ if (db.password) { _%>
password = <%= db.password %>
<%_ } _%>
dbname = <%= db.dbname %>
query = SELECT destination FROM mail_forwards_v WHERE source = '%s'
