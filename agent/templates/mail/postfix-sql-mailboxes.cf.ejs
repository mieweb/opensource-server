# Managed by opensource-agent — Postfix virtual_mailbox_maps (live SQL).
# Existence check only: unknown recipients are rejected at RCPT.
hosts = <%= db.hosts %>
user = <%= db.user %>
<%_ if (db.password) { _%>
password = <%= db.password %>
<%_ } _%>
dbname = <%= db.dbname %>
query = SELECT 1 FROM mail_recipients_v WHERE recipient = '%s'
