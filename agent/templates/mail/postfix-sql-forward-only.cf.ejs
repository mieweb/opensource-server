# Managed by opensource-agent — Postfix forward-only recipient access map.
# Only recipients with forwarding destinations and no self-alias bypass quota.
hosts = <%= db.hosts %>
user = <%= db.user %>
<%_ if (db.password) { _%>
password = <%= db.password %>
<%_ } _%>
dbname = <%= db.dbname %>
query = SELECT 'OK' FROM mail_forwards_v f WHERE f.source = '%s' AND f.destination <> f.source AND NOT EXISTS (SELECT 1 FROM mail_forwards_v local_copy WHERE local_copy.source = f.source AND local_copy.destination = local_copy.source) LIMIT 1
