[Unit]
Description=Per-container usage metrics (OTLP) for create-a-container
After=network.target container-creator-init.service
Wants=container-creator-init.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/opensource-server/create-a-container
ExecStart=/usr/bin/node /opt/opensource-server/create-a-container/usage-collector.js
# Exits 0 (and stays stopped) unless OTEL_EXPORTER_OTLP_ENDPOINT is set in the
# EnvironmentFile — the collector is a no-op without an OTel backend.
Restart=on-failure
Environment=NODE_ENV=production
EnvironmentFile=/etc/default/container-creator

[Install]
WantedBy=multi-user.target
